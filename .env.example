APP_NAME=Claryeo
APP_ENV=local
APP_KEY=  
APP_DEBUG=true
APP_URL=http://localhost:8088
# Public host of THIS marketing site (used for canonical/SEO + asset URLs).
APP_DOMAIN=localhost
ASSET_URL="${APP_URL}"
MARKETING_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# ─── Cache / session / queue (flat-file: NO database) ────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Shared cookie scope across app + console + marketing in prod (".claryeo.com").
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false   
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
TRUSTED_PROXIES=*


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Main app integration (internal API over private networking) ─────────────
# Base URL of the main Claryeo app. The MainApi client appends /api/internal.
# Local: the running main app (e.g. http://127.0.0.1:8000).
# Railway: http://web.railway.internal:${{web.PORT}}
MAIN_API_URL=http://127.0.0.1:8000
# Shared secret — MUST match INTERNAL_API_TOKEN on the main app.
INTERNAL_API_TOKEN=
# Where get-started / login CTAs hand off to (the authenticated app).
CLARYEO_APP_URL=https://app.claryeo.com

# ─── Marketing behaviour ─────────────────────────────────────────────────────
# Mirror the main app's flag. When true: every CTA -> waitlist, pricing hidden.
WAITLIST_MODE=true

STATAMIC_LICENSE_KEY=
STATAMIC_PRO_ENABLED=false
STATAMIC_STACHE_WATCHER=auto
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false
STATAMIC_GIT_AUTOMATIC=false

DEBUGBAR_ENABLED=false
