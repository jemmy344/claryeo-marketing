# Statamic 6 ships the CP as a build artifact: resources/dist is empty in the
# Composer package, so the compiled CP assets are NOT in the download and CANNOT
# be regenerated in the Docker image (statamic:install finds nothing to publish
# and the Vite manifest goes missing — 500s the CP). Commit the published CP
# assets so they ship via COPY. Re-run
# `php artisan vendor:publish --tag=statamic-cp --force` and recommit after every
# Statamic upgrade.
/public/vendor/statamic/*
!/public/vendor/statamic/cp
/storage/*.key
/storage/pail
/users/*
!/users/.gitkeep
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db