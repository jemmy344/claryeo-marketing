# ─── PHP-FPM upstream (localhost – same container via supervisord) ───────────
upstream php-fpm {
    server 127.0.0.1:9000;
    keepalive 16;
}

# ─── Marketing site (Statamic) ───────────────────────────────────────────────
server {
    listen ${PORT};
    server_name ${APP_DOMAIN} _;

    root  /var/www/html/public;
    index index.php;

    charset utf-8;

    # Security headers
    add_header X-Frame-Options        "SAMEORIGIN"    always;
    add_header X-Content-Type-Options "nosniff"       always;
    add_header Referrer-Policy        "strict-origin" always;

    # Laravel health-check endpoint
    location = /up {
        try_files $uri /index.php?$query_string;
    }

    # Vite build output – long-lived immutable cache
    location /build/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Statamic control-panel assets + other static files
    location ~* \.(ico|svg|png|jpe?g|gif|webp|woff2?|ttf|eot|css|js|map)$ {
        try_files $uri /index.php?$query_string;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # Everything else → Statamic / Laravel front controller
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    # robots.txt is served dynamically by Laravel (host-aware), so fall through to PHP.
    location = /robots.txt  { access_log off; log_not_found off; try_files $uri /index.php?$query_string; }

    location ~ \.php$ {
        fastcgi_pass         php-fpm;
        fastcgi_index        index.php;
        fastcgi_param        SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include              fastcgi_params;
        # Railway terminates TLS at the edge; forward proxy headers so Laravel
        # TrustProxies can detect HTTPS and issue secure session cookies.
        fastcgi_param        HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param        HTTP_X_FORWARDED_FOR   $proxy_add_x_forwarded_for;
        fastcgi_read_timeout 300;
        fastcgi_buffers      16 16k;
        fastcgi_buffer_size  32k;
        fastcgi_intercept_errors off;
    }

    # Deny access to sensitive flat-file content / dotfiles
    location ~ /\.(?!well-known).* { deny all; }

    error_log  /var/log/nginx/marketing_error.log;
    access_log /var/log/nginx/marketing_access.log main;
}
